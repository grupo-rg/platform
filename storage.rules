rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // General safety measure: Nothing completely public by default
      allow read, write: if false;
    }

    // Public Assets: Next.js or Browser viewing images
    match /dream-renovator/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // AI Generated Renders and Originals
    match /renders/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Budget Multimedia: allow user to upload PDF / Jpegs (< 10 MB)
    match /budget-multimedia/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/pdf'));
    }

    // Simple Uploads — restringido a image/* y application/pdf para
    // evitar que se suba .html con XSS, .exe, scripts, etc.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('application/pdf')
                   );
    }

    // LEGACY public uploads: fotos/PDFs de leads de antes de la Fase 0-C.
    // Se mantiene la LECTURA para no romper URLs antiguas ya guardadas en
    // leads/conversaciones, pero ya no se admite ninguna escritura cliente:
    // los adjuntos nuevos van a `lead_uploads/` vía server action.
    match /public_uploads/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Adjuntos PRIVADOS de leads (formularios públicos y chat):
    //   lead_uploads/{leadId|sessionId}/{uuid}.{ext}
    // Sólo Admin SDK (server actions). El panel los muestra con URLs firmadas
    // de corta duración generadas en servidor. Ningún acceso cliente.
    match /lead_uploads/{allPaths=**} {
      allow read, write: if false;
    }

    // Admin Base rules: el price book sólo lo gestionan administradores
    // autenticados con custom claim `admin == true`. Lectura idem — el
    // catálogo de precios es información comercial sensible.
    match /admin/price-books/{allPaths=**} {
       allow read: if request.auth != null && request.auth.token.admin == true;
       allow write: if request.auth != null
                    && request.auth.token.admin == true
                    && request.resource.size < 10 * 1024 * 1024;
    }

    // Pipeline Uploads — PDFs y BC3 subidos directamente desde el navegador
    // antes de que el dispatcher arranque el Cloud Run Job. Path layout:
    //
    //   pipeline_uploads/{uid}/{jobId}/{filename}
    //
    // El uid en el path debe coincidir con el del usuario autenticado.
    // Tamaño máximo 100 MB (los PDFs de 250+ páginas pesan ~30-50 MB).
    // El bucket aplica una lifecycle rule (7 días) sobre este prefijo —
    // ver `services/ai-core/scripts/setup-infrastructure.sh`.
    //
    // Sprint 4 Fase L — soporte BC3 (FIEBDC-3). Los .bc3 no tienen MIME
    // estándar; el uploader los sube como application/octet-stream + valida
    // extensión client-side. Aquí permitimos:
    //   - application/pdf  (PDFs tradicionales)
    //   - application/octet-stream cuando el filename termina en .bc3.
    match /pipeline_uploads/{uid}/{jobId}/{filename} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.token.admin == true);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024
                   && (
                     request.resource.contentType == 'application/pdf'
                     || (
                       request.resource.contentType == 'application/octet-stream'
                       && filename.lower().matches('.*[.]bc3')
                     )
                   );
    }
  }
}
