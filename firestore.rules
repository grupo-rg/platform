rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow client to send emails
    match /mail/{mailId} {
      allow create: if true;
    }

    // Allow frontend client to write tracking analytics
    match /analytics/{docId} {
      allow write: if true;
    }

    // Pipeline Jobs — coordination layer for the long-running budget
    // pipeline (replaces the legacy BackgroundTasks). The Service / Worker
    // (admin SDK) own the lifecycle; clients are restricted to reading
    // their own jobs and requesting cancellation.
    match /pipeline_jobs/{jobId} {
      // Owner can READ the doc to drive the UI (status, attempts, error).
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Owner can CREATE the initial queued doc (the dispatcher will
      // overwrite via admin SDK immediately, but allowing client create
      // keeps the dispatch flow resilient if the dispatcher is slow).
      // The status MUST be 'queued' — clients can't fast-forward state.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued';

      // Owner can ONLY flip cancellation_requested (and bump updatedAt).
      // Every other field stays admin-SDK-only.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['cancellation_requested', 'updatedAt']);

      // Subcollections: owner can read, admin SDK writes.
      match /attempts/{attemptId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/pipeline_jobs/$(jobId)).data.uid == request.auth.uid;
      }
      match /checkpoints/{partidaCode} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/pipeline_jobs/$(jobId)).data.uid == request.auth.uid;
      }
    }

    // Pipeline telemetry stays open for the SSE stream that the Service's
    // `/api/budget/stream` endpoint tails. Anything sensitive lives in
    // `pipeline_jobs/*` above.

    // Blog público — los posts son legibles por cualquiera (alimentan el
    // listado y el detalle en /blog). Las escrituras pasan SIEMPRE por el
    // admin SDK desde server actions autenticadas (no afectadas por estas
    // rules); por eso el write cliente se bloquea explícitamente. Sin esto,
    // una clave Firebase del bundle filtrada podría inyectar/borrar posts.
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Misma colección en modo test (NEXT_PUBLIC_USE_TEST_DB=true).
    match /test_blog_posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Briefs editoriales — internos del dashboard, NUNCA accesibles desde
    // cliente. La generación + revisión va siempre por server actions con
    // admin SDK. Bloqueado completamente.
    match /content_briefs/{briefId} {
      allow read, write: if false;
    }
    match /test_content_briefs/{briefId} {
      allow read, write: if false;
    }

    // S1-A-04 — Pricing cache by hash. Written by ai-core (admin SDK) when
    // a partida is resolved with high confidence, read at the start of every
    // pricing batch to short-circuit repeated partidas. No client access:
    // the data is keyed by sha256(description+unit) and would leak nothing
    // sensitive, but there is also no reason to expose it to clients.
    match /partida_pricing_cache/{hash} {
      allow read, write: if false;
    }

    // S2-B-03 — Wizard sessions persisted so a reload mid-job doesn't lose
    // context. Reads only for the owner (uid match); writes are admin-SDK
    // only because they go through `appendWizardMessageAction` and friends.
    match /wizard_sessions/{sessionId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // S3-07 — RLHF Correction Pairs.
    // Cada vez que un humano corrige una partida en el editor, el server
    // action `logCorrectionPairAction` persiste el par
    //   (query_text, ai_proposed, human_chosen)
    // aquí. Es dataset de reentreno del bi-encoder/reranker; ningún cliente
    // debe poder leer o escribir directo.
    match /correction_pairs/{pairId} {
      allow read, write: if false;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
